NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/alceix?replicaSet=rs0
FRONTEND_ORIGIN=http://localhost:3000
MEDIA_DIRECTORY=var/media
SESSION_DAYS=7
# Optional: password recovery and email verification require SMTP.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM=destek@example.com
# SMTP_USER=
# SMTP_PASSWORD=

# Provider bridge implementing backend/docs/integration-gateway-v1.md.
# Configure all three together; real provider adapters live behind this bridge.
# COMMERCE_GATEWAY_URL=https://your-provider-bridge.example.com
# COMMERCE_GATEWAY_TOKEN=replace-with-at-least-32-random-characters
# COMMERCE_WEBHOOK_SECRET=replace-with-another-32-random-characters

MAX_ACTIVE_RESERVATIONS=5

# CLI maintenance commands force workers off; API deployments normally leave them on.
WORKERS_ENABLED=true
# Disabled until explicitly enabled. Only new, never-used uploads are eligible.
UPLOAD_CLEANUP_ENABLED=false
UNCLAIMED_UPLOAD_HOURS=72
